{
  "name": "tts-lab-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "build": "ng build",
    "generate:api-contract": "openapi-typescript ../shared/api-contract/tts-lab-openapi.yaml --root-types --root-types-no-schema-prefix --export-type -o src/app/shared/api-contract.generated.ts",
    "verify:api-contract": "openapi-typescript ../shared/api-contract/tts-lab-openapi.yaml --root-types --root-types-no-schema-prefix --export-type -o src/app/shared/api-contract.generated.ts --check",
    "lint": "node scripts/lint-src.mjs",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.12",
    "rxjs": "^7.8.1",
    "wavesurfer.js": "^7.12.6",
    "zone.js": "^0.14.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@playwright/test": "^1.54.0",
    "@types/jasmine": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.50.0",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.5"
  }
}
